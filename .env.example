# Server Configuration
PORT=5000
NODE_ENV=development

# AI API Key (Optional: If omitted, system runs in Smart Demo AI Engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Supabase Configuration (Optional: Connects to your Supabase project)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PostgreSQL Database (Optional: Fallbacks to local persistent store if omitted)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/deal_intelligence
